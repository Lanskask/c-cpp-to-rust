{
  "permissions": {
    "allow": [
      "Agent(model:haiku)",
      "Agent(model:sonnet)",
      "Agent(model:opus)"
    ],
    "deny": [
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git clean:*)",
      "Bash(git push:*)",
      "Bash(git commit --amend:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch",
      "WebSearch",
      "Edit(pilots/*/src/**)",
      "Edit(pilots/*/UPSTREAM)",
      "Edit(/skill/**)",
      "Edit(/docs/**)",
      "Edit(/experiments/**)",
      "Edit(PLAN.md)",
      "Edit(CONTEXT.md)",
      "Edit(.claude/**)",
      "Edit(pilots/*/migration/gate-passed.tsv)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/skill/c-cpp-to-rust/scripts/guard.py\""
          }
        ]
      }
    ]
  }
}
